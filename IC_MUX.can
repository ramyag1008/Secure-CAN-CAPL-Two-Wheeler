void HandleIC_Diagnostic(
  byte b0,
  byte b1,
  byte b2,
  byte b3,
  byte b4,
  byte b5,
  byte b6,
  byte b7)
{
  write("");
  write("============================================================");
  write("[IC_RX] CAN ID 0x7E2 - Diagnostic Request");
  write("[IC_RX] DATA = [%02X %02X %02X %02X %02X %02X %02X %02X]",
        b0,b1,b2,b3,b4,b5,b6,b7);

  write("[IC_RX] Diagnostic Request Received");

  txIC_DiagResp.id = 0x7EA;
  txIC_DiagResp.dlc = 8;

  txIC_DiagResp.byte(0) = 0x50;
  txIC_DiagResp.byte(1) = b1;
  txIC_DiagResp.byte(2) = 0x00;
  txIC_DiagResp.byte(3) = 0x00;
  txIC_DiagResp.byte(4) = 0x00;
  txIC_DiagResp.byte(5) = 0x00;
  txIC_DiagResp.byte(6) = 0x00;
  txIC_DiagResp.byte(7) = 0x00;

  write("[IC_TX] CAN ID 0x7EA - Diagnostic Response");
  write("[IC_TX] DATA = [%02X %02X %02X %02X %02X %02X %02X %02X]",
        txIC_DiagResp.byte(0),
        txIC_DiagResp.byte(1),
        txIC_DiagResp.byte(2),
        txIC_DiagResp.byte(3),
        txIC_DiagResp.byte(4),
        txIC_DiagResp.byte(5),
        txIC_DiagResp.byte(6),
        txIC_DiagResp.byte(7));

  output(txIC_DiagResp);

  write("[IC_TX] 0x7EA DIAGNOSTIC RESPONSE TRANSMITTED");
  write("============================================================");
}

on message *
{
  dword id;
  byte b0; 
  byte b1; 
  byte b2; 
  byte b3; 
  byte b4; 
  byte b5; 
  byte b6; 
  byte b7;
  
  id = this.id;
  if (this.dlc < 1) 
    return;
  // Rapidly unload current byte payload configurations out of the bus interface
  b0 = this.byte(0); 
  b1 = 0; 
  b2 = 0; 
  b3 = 0; 
  b4 = 0; 
  b5 = 0;
  b6 = 0; 
  b7 = 0;
  
  if (this.dlc > 1) b1 = this.byte(1); 
  if (this.dlc > 2) b2 = this.byte(2);
  if (this.dlc > 3) b3 = this.byte(3); 
  if (this.dlc > 4) b4 = this.byte(4);
  if (this.dlc > 5) b5 = this.byte(5); 
  if (this.dlc > 6) b6 = this.byte(6);
  if (this.dlc > 7) b7 = this.byte(7);
  // Match the message ID to its parsing routine
  switch (id)
  {
    case 0x100: // EMS_Data_Msg
      if (this.dlc == 8) 
        VerifyEMS_MUX(b0, b1, b2, b3, b4, b5, b6, b7);
      break;
    
    case 0x110: // ABS_Sensor_Msg
      if (this.dlc == 8) 
        VerifyABS_MUX(b0, b1, b2, b3, b4, b5, b6, b7);
      break;
    
    case 0x120: // ABS_Sensor_Error_msg
      if (this.dlc == 8) 
        VerifyABS_Error8(b0, b1, b2, b3, b4, b5, b6, b7);
      break;
    
    case 0x101: // EMS_Error_Msg
      if (this.dlc == 4) 
        VerifyEMS_Error4(b0, b1, b2, b3);
      break;
    
    case 0x130: // Dec 304 : Cluster Indication
      if (this.dlc == 8)
      {
        Secure_Decrypt(b0, b1, b2, b3, b4, b5); 
      }
      break;  
    
    case 0x300:
      if (this.dlc == 8)
        VerifyLighting_Indication(b0,b1,b2,b3,b4,b5,b6,b7);
      break;

    case 0x310:
      if (this.dlc == 8)
        VerifyLighting_Error(b0,b1,b2,b3,b4,b5,b6,b7);
      break;

    case 0x320:
      if (this.dlc == 8)
        VerifyKeyless_Status(b0,b1,b2,b3,b4,b5,b6,b7);
      break;
      
    case 0x7E2:
      if (this.dlc >= 2)
        HandleIC_Diagnostic(this.byte(0),this.byte(1),this.byte(2),this.byte(3),this.byte(4),this.byte(5),this.byte(6),this.byte(7));
      break; 
      
      default:
      break;
  }
}
